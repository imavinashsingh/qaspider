{
  "name": "qaspider",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "benchmark": "tsx apps/benchmark/src/main.ts",
    "cli": "tsx packages/cli/src/main.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "bin": {
    "qaspider": "dist/packages/cli/src/main.js"
  }
}
