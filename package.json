{
  "name": "qaspider",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "desktop": "npm run start --workspace @qaspider/desktop",
    "desktop:build": "npm run build --workspace @qaspider/desktop",
    "desktop:test": "npm run test --workspace @qaspider/desktop",
    "desktop:smoke": "npm run test:smoke --workspace @qaspider/desktop",
    "desktop:demo": "npm run demo --workspace @qaspider/desktop",
    "desktop:verify-live": "npm run verify:live --workspace @qaspider/desktop",
    "desktop:verify-login": "npm run verify:login --workspace @qaspider/desktop",
    "desktop:verify-ticket": "npm run verify:ticket --workspace @qaspider/desktop",
    "desktop:verify-review": "npm run verify:review --workspace @qaspider/desktop",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs && vite build",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "benchmark": "tsx apps/benchmark/src/main.ts",
    "cli": "tsx packages/cli/src/main.ts",
    "verify:provider": "npm run build && node scripts/verify-provider.mjs",
    "prestart": "npm run build",
    "start": "node scripts/start.mjs",
    "start:studio": "tsx packages/cli/src/main.ts studio",
    "start:benchmark": "tsx apps/benchmark/src/main.ts",
    "start:mcp": "node dist/packages/cli/src/main.js serve --mcp",
    "start:demo": "npm run build && node scripts/start.mjs --benchmark",
    "verify:story-first": "npm run build && node scripts/verify-story-first.mjs",
    "start:engine": "node dist/packages/engine/src/main.js",
    "start:bridge": "node dist/packages/bridge/src/main.js",
    "start:studio-client": "node dist/packages/studio/src/client-main.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "better-sqlite3": "^12.0.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "zod": "$zod"
  },
  "bin": {
    "qaspider": "dist/packages/cli/src/main.js"
  }
}
