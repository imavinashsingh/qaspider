{
  "name": "@qaspider/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:smoke": "npm run build && playwright test",
    "demo": "node demo/server.mjs",
    "verify:live": "npm run build && node scripts/verify-live.mjs",
    "verify:login": "npm run build && node scripts/verify-login.mjs",
    "verify:ticket": "npm run build && node scripts/verify-ticket.mjs",
    "verify:review": "npm run build && node scripts/verify-review.mjs",
    "verify:execution": "npm run build && playwright test tests/approved-execution.spec.mjs",
    "benchmark:knowledge": "node scripts/benchmark-knowledge.mjs"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "4.3.0",
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "langsmith": "0.11.1",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "45.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
