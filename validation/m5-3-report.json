  "backend": {
    "separation": [
      "Read-only story analysis from stored navigation and approved scenario summaries",
      "Deterministic permission requirement derivation from actual scenario operations",
      "Explicit human plan/requirement approval",
      "Append-only human Allow/Deny decisions",
      "Minimum typed runtime policy compilation per scenario",
      "AI-free deterministic execution with revalidation at relevant actions and intercepted POSTs"
    ],
    "contracts": [
      "ProposedTestPlan/ProposedScenario aliases reuse existing strict proposal validation",
      "PermissionRequirement with strict Zod schema",
      "PermissionDecision and strict decision input validation",
      "ApprovedExecutionPlan",
      "ExecutionAuthorization"
    ],
    "planning": "No browser discovery or application actions during planning. Missing scopes may be represented as unavailable targets; execution blocks them. HTTP/MCP caller policy data cannot grant authority.",
    "approvalPersistence": "Workspace-local database plus application/environment/role-set/tenant/build/feature-flags scope, exact revision ID and content hash, exact request snapshot, reviewer and timestamp. Decisions are append-only. Edits/configuration/revisions copy no decisions. Superseded managed revisions cannot execute.",
    "leastPrivilege": "Only submission steps, HTTP assertions and owned fixture lifecycles derive requests. Unused AI allowedActions and broad policy entries grant nothing. Denied/pending/unsupported operations block their scenarios before setup or application interactions; independent authorized cases continue.",
    "cli": [
      "plan generate without --policy",
      "plan permissions",
      "plan authorize with exact --hash and decision file",
      "plan configure-access creates an unapproved revision"
    ],
    "compatibility": "Historical explicit-policy plans and explicit local CLI --policy input retain the reviewed operator policy contract. Editing a legacy plan adopts new access decisions. Browser and MCP planning use proposal-only mode."
  },
  "frontend": {
    "steps": [
      "Describe",
      "Review Plan",
      "Approve Access",
      "Execute",
      "Results"
    ],
    "features": [
      "Single Generate Test Plan action with no prerequisite endpoint grants",
      "Existing stories/plans and unmapped configured environments",
      "Scenario cards with role/environment, precondition, steps, expected outcomes, data and cleanup",
      "Direct title editing, advanced complete-proposal editing and Codex revision requests",
      "Risk/impact/origin/scenario/cleanup cards with individual Allow/Deny decisions",
      "Separate exact-plan and side-effect approval",
      "Advanced lifecycle configuration after planning",
      "Actual job progress, cancellation/retry, loading access checks and persisted reports/evidence",
      "Approved-plan execution without another AI call"
    ],
